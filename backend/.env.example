# Blue backend — exemplo de variáveis de ambiente.
# Copie para `.env` (nunca versionar `.env` com valores reais).
# Valores abaixo são apenas para desenvolvimento local.

# Ambiente: development | test | production
ENVIRONMENT=development

# PostgreSQL (SQLAlchemy 2.x + driver psycopg v3)
DATABASE_URL=postgresql+psycopg://blue:blue@localhost:5432/blue

# JWT (ADR-014: access token sem refresh no MVP). Troque em produção!
JWT_SECRET_KEY=dev-only-change-me-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
